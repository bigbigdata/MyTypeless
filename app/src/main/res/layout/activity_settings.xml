<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ime_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MyTypeless 語音輸入法設定"
        android:textColor="@color/ime_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="配置雙階段 AI 引擎（Groq 極速轉錄 + Gemini 智慧潤飾），徹底實現零成本、零卡頓的語音輸入體驗。"
                android:textColor="@color/ime_text_secondary"
                android:textSize="14sp" />

            <!-- Stage 1: Groq Whisper API Key -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 語音轉文字（Groq Whisper，極速免綁卡）"
                android:textColor="@color/ime_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Groq API Key (gsk_...)"
                android:textColorHint="@color/ime_text_secondary"
                app:boxStrokeColor="@color/ime_primary"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_groq_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/ime_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_get_groq_key"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⚡ 1 分鐘免費取得 Groq API Key（免綁信用卡）"
                android:textColor="@color/ime_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="提示：Groq 每天提供高額免費額度，轉錄中英混雜速度達到 200 倍速。"
                android:textColor="@color/ime_text_secondary"
                android:textSize="12sp" />

            <!-- Stage 2: Gemini API Key -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. 智慧繁體去贅字（Google Gemini）"
                android:textColor="@color/ime_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Gemini API Key (AIza...)"
                android:textColorHint="@color/ime_text_secondary"
                app:boxStrokeColor="@color/ime_primary"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/ime_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_get_gemini_key"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="🔑 免費取得 Gemini API Key (aistudio.google.com)"
                android:textColor="@color/ime_primary"
                android:textSize="12sp" />

            <!-- Section 3: Personal Vocabulary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. 個人專屬詞庫（中英夾雜精準偏誤注入）"
                android:textColor="@color/ime_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_vocab_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="已收錄常用專有名詞，點擊自訂或新增詞彙"
                android:textColor="@color/ime_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_manage_vocabulary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="📚 管理個人專屬詞庫與權重"
                android:textColor="@color/ime_primary"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_save"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/ime_primary"
        android:text="儲存並啟用"
        android:textColor="@color/ime_on_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
