<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ime_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/ime_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="個人自訂詞庫"
                android:textColor="@color/ime_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_reset_defaults"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重設預設"
                android:textColor="#E57373"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_vocab_header_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="高頻專有名詞會動態注入 Whisper 與 Gemini 雙階段，精確鎖定中英夾雜語境與專有縮寫大小寫。"
            android:textColor="@color/ime_text_secondary"
            android:textSize="13sp" />

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="搜尋詞彙或標籤..."
            android:textColorHint="@color/ime_text_secondary"
            app:boxStrokeColor="@color/ime_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_vocab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/ime_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Vocabulary List -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_vocabulary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="72dp" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="尚無相符詞彙，點擊右下角 ＋ 新增"
                android:textColor="@color/ime_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Floating Action Button for adding words -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_term"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:backgroundTint="@color/ime_primary"
        android:text="新增詞彙"
        android:textColor="@color/ime_on_primary"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/ime_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
